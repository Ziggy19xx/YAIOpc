<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><StartupObject>CombinedStudio.Program</StartupObject><ImplicitUsings>disable</ImplicitUsings><Nullable>annotations</Nullable><EnableDefaultPageItems>false</EnableDefaultPageItems><AssemblyName>FramePilot</AssemblyName><Product>FramePilot</Product><Version>4.0.0</Version><ApplicationIcon>FramePilot/src/FramePilot.ico</ApplicationIcon></PropertyGroup>
<ItemGroup><PackageReference Include="NAudio" Version="2.2.1"/><PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1"/><PackageReference Include="System.Management" Version="8.0.0"/><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/></ItemGroup>
<ItemGroup><Compile Remove="FramePilot/src/AssemblyInfo.cs;VelvetVoice/Installer.cs"/></ItemGroup>
<ItemGroup><EmbeddedResource Include="FramePilot/wpf/MainWindow.xaml" LogicalName="MainWindow.xaml"/><EmbeddedResource Include="FramePilot/wpf/hero.jpg" LogicalName="hero.jpg"/><EmbeddedResource Include="FramePilot/presets/starter-*.json" LogicalName="%(Filename)%(Extension)"/><EmbeddedResource Include="VelvetVoice/Wpf/Shell.xaml" LogicalName="VelvetVoice.Wpf.Shell.xaml"/><EmbeddedResource Include="VelvetVoice/Assets/hero.jpg" LogicalName="VelvetVoice.Assets.hero.jpg"/><EmbeddedResource Include="VelvetVoice/Assets/logo.png" LogicalName="VelvetVoice.Assets.logo.png"/></ItemGroup>
<ItemGroup><Content Include="VelvetVoice/python/**/*" Link="python/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/><Content Include="VelvetVoice/Assets/rnnoise.dll" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/><Content Include="VelvetVoice/Assets/silero_vad.onnx" Link="silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/></ItemGroup>
</Project>

