  <SolidColorBrush x:Key="Panel" Color="#1A1613"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#221C18"/>
  <SolidColorBrush x:Key="Line" Color="#2B231D"/>
  <SolidColorBrush x:Key="Ink" Color="#F3ECE4"/>
  <SolidColorBrush x:Key="Muted" Color="#A39789"/>
  <SolidColorBrush x:Key="Dim" Color="#6F6358"/>
