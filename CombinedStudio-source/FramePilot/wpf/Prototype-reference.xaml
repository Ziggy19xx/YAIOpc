<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FramePilot 3.1 | WPF UI example"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="#0F131B" Foreground="#E8EFF8"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">

  <Window.Resources>
    <!-- Theme colors: same palette as the WinForms build, defined once -->
    <SolidColorBrush x:Key="Bg" Color="#0F131B"/>
    <SolidColorBrush x:Key="Panel" Color="#181F2B"/>
    <SolidColorBrush x:Key="Ink" Color="#E8EFF8"/>
    <SolidColorBrush x:Key="Muted" Color="#9FB0C4"/>
    <SolidColorBrush x:Key="Accent" Color="#6BEBC0"/>
    <SolidColorBrush x:Key="Line" Color="#344255"/>

    <!-- Flat rounded button with hover and press states -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#26483F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar navigation item: a RadioButton drawn as a highlighted row -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F2937"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#264845"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim rounded progress bar (applies to every ProgressBar in the window) -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Background" Value="#0F131B"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" CornerRadius="4"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="44"/>
    </Grid.RowDefinitions>

    <!-- Sidebar -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Panel}" Padding="16,24,16,16">
      <StackPanel>
        <TextBlock Text="FRAME / PILOT" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource Accent}"/>
        <TextBlock Text="PERFORMANCE STUDIO / 3.1" FontSize="11"
                   Foreground="{StaticResource Muted}" Margin="0,4,0,24"/>
        <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}"
                     GroupName="nav" Tag="Overview" Content="Overview" IsChecked="True"/>
        <RadioButton x:Name="NavOptimizations" Style="{StaticResource NavItem}"
                     GroupName="nav" Tag="Optimizations" Content="Optimizations"/>
        <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}"
                     GroupName="nav" Tag="Game library" Content="Game library"/>
        <RadioButton x:Name="NavRecovery" Style="{StaticResource NavItem}"
                     GroupName="nav" Tag="Recovery" Content="Recovery"/>
      </StackPanel>
    </Border>

    <!-- Content area: pages overlap in one grid cell, visibility is toggled in code -->
    <Grid Grid.Row="0" Grid.Column="1" Margin="28,22,28,10">

      <!-- Overview page -->
      <StackPanel x:Name="PageOverview">
        <TextBlock Text="Your performance cockpit." FontSize="28" FontWeight="Bold"/>
        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,20"
                   Text="Choose what to change. Keep a baseline. Your games and security stay in control."/>

        <!-- Three metric tiles; the grid resizes with the window -->
        <UniformGrid Columns="3">
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="CPU LOAD" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="CpuValue" Text="--" FontSize="30" FontWeight="Bold"
                         Foreground="{StaticResource Accent}" Margin="0,4,0,10"/>
              <ProgressBar x:Name="CpuBar"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="RAM IN USE" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="RamValue" Text="--" FontSize="30" FontWeight="Bold"
                         Foreground="{StaticResource Accent}" Margin="0,4,0,10"/>
              <ProgressBar x:Name="RamBar"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16">
            <StackPanel>
              <TextBlock Text="GPU LOAD" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="GpuValue" Text="--" FontSize="30" FontWeight="Bold"
                         Foreground="{StaticResource Accent}" Margin="0,4,0,10"/>
              <ProgressBar x:Name="GpuBar"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button x:Name="SnapshotButton" Style="{StaticResource FlatButton}"
                  Content="Take resource snapshot"/>
          <Button x:Name="BrowseButton" Style="{StaticResource FlatButton}"
                  Content="Browse optimizations"/>
          <CheckBox x:Name="Monitoring" Content="Live monitoring (1s)"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Text="BUILT FOR YOUR SETUP" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Muted}" Margin="0,28,0,6"/>
        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Values on this page are simulated for the example. In the real app they would come from your existing ResourceSampler class."/>
      </StackPanel>

      <!-- Optimizations page: cards come from a list through data binding -->
      <Grid x:Name="PageOptimizations" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Know what each switch does." FontSize="28" FontWeight="Bold"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"
                     Text="Orange = HIGH potential. Yellow = MEDIUM. Blue = LOW. Potential is not a measured gain."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Cards">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="320" Margin="0,0,12,12" Padding="16" CornerRadius="12"
                        Background="{StaticResource Panel}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" Margin="0,6,0,12"/>
                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="10,4"
                            Background="{Binding ImpactBrush}">
                      <TextBlock Text="{Binding Impact}" FontSize="12" FontWeight="Bold"
                                 Foreground="#0F131B"/>
                    </Border>
                    <TextBlock Text="Gain/loss: unmeasured" FontSize="12"
                               Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Placeholder for pages not ported in this example -->
      <StackPanel x:Name="PagePlaceholder" Visibility="Collapsed">
        <TextBlock x:Name="PlaceholderTitle" Text="" FontSize="28" FontWeight="Bold"/>
        <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                   Text="Not ported in this example. This page would be rebuilt next."/>
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Panel}">
      <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="18,0"
                 Foreground="{StaticResource Accent}"/>
    </Border>
  </Grid>
</Window>
